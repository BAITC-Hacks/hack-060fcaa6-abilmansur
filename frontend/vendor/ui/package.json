{
  "type": "module",
  "name": "@inv/ui",
  "license": "MIT",
  "version": "0.16.2",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./index.css": {
      "default": "./dist/styles/index.css"
    },
    "./components.css": {
      "default": "./dist/components/index.css"
    },
    "./layered/styles/index.css": {
      "default": "./dist/layered/styles/index.css"
    },
    "./defaults.css": {
      "default": "./dist/styles/inv-defaults.css"
    },
    "./styles/*": {
      "default": "./dist/styles/*"
    },
    "./layered/styles/*": {
      "default": "./dist/layered/styles/*"
    },
    "./genui-lib": {
      "import": {
        "types": "./dist/genui-lib/index.d.mts",
        "default": "./dist/genui-lib/index.mjs"
      },
      "require": {
        "types": "./dist/genui-lib/index.d.cts",
        "default": "./dist/genui-lib/index.cjs"
      }
    },
    "./genui-lib/prompt-options": {
      "import": {
        "types": "./dist/genui-lib/prompt-options/index.d.mts",
        "default": "./dist/genui-lib/prompt-options/index.mjs"
      },
      "require": {
        "types": "./dist/genui-lib/prompt-options/index.d.cts",
        "default": "./dist/genui-lib/prompt-options/index.cjs"
      }
    },
    "./scssUtils": {
      "default": "./dist/styles/cssUtils.scss"
    },
    "./*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "require": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.cjs"
      }
    }
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "peerDependencies": {
    "@inv/headless": "workspace:*",
    "@inv/lang": "workspace:*",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zustand": "^4.5.5",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.562.0",
    "react-day-picker": "^9.5.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tiny-invariant": "^1.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "private": true
}
