ANTHROPIC_API_KEY=

# Agent
# Claude Code CLI launched by the SDK. Empty = the copy bundled with claude-agent-sdk (works anywhere).
# Set it to your own install (e.g. ~/.local/bin/claude) to run the same version as your `claude`.
CLAUDE_CLI_PATH=
AGENT_MODEL=claude-sonnet-5
AGENT_EFFORT=medium
AGENT_MAX_TURNS=200
AGENT_MAX_BUDGET_USD=20
REPORT_LANGUAGE=ru

# Worker
WORKER_CONCURRENCY=2

# Analytics
STRUCTURING_THRESHOLD=1000000
SQL_MAX_ROWS=500

# Datasets, SQLite and agent workspaces
DATA_DIR=./data
